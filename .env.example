DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional: restrict owner-only commands to your Discord ID
OWNER_ID=
# Optional: set status log level
LOG_LEVEL=info

# Optional live Pterodactyl power actions; disabled by default
PTERODACTYL_ACTIONS_ENABLED=false
PTERODACTYL_URL=https://panel.aureliushosting.com
PTERODACTYL_CLIENT_API_KEY=
AI_DEBUG=false

# Reuse your existing verified AureliusAccounts Paymenter link bridge
PAYMENTER_URL=https://billing.aureliushosting.com
PAYMENTER_API_KEY=
# Read customer Panel ownership through the Pterodactyl Application API
PTERODACTYL_APPLICATION_API_KEY=
# Required for logging every live action request and result
AI_ACTION_LOG_CHANNEL_ID=

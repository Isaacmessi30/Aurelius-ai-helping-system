# Aurelius AI Support — replace placeholders on your Pterodactyl server
# Never share the filled-in file or commit real tokens to GitHub.
DISCORD_TOKEN=REPLACE_WITH_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=REPLACE_WITH_DISCORD_APPLICATION_ID
DISCORD_GUILD_ID=REPLACE_WITH_DISCORD_SERVER_ID
DEEPSEEK_API_KEY=REPLACE_WITH_DEEPSEEK_KEY
DEEPSEEK_MODEL=deepseek-flash
OWNER_ID=
# Optional: configuration can also be changed with /ai commands
# Empty settings use data/config.json, which slash commands edit.
AI_ENABLED=
TICKET_CHANNEL_IDS=
TICKET_CATEGORY_IDS=
STAFF_ROLE_IDS=
LOG_CHANNEL_ID=
AI_LANGUAGE=en
AI_COOLDOWN_SECONDS=10
AI_MAX_HISTORY=12
AI_MAX_OUTPUT_TOKENS=500
AI_MONTHLY_REQUEST_LIMIT=1000
AI_MONTHLY_TOKEN_LIMIT=1000000
AI_DEBUG=true
LOG_LEVEL=info
